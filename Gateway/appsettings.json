{
  "ReverseProxy": {
    "Routes": {
      "managers": {
        "ClusterId": "managers",
        "Match": {
          "Path": "/api/Manager/{**catch-all}"
        }
      },
      "reports": {
        "ClusterId": "reports",
        "Match": {
          "Path": "/api/Report/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "managers": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5083/"
          }
        }
      },
      "reports": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5084/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
